# Copie para .env e ajuste os valores (NUNCA versione o .env real).
POSTGRES_DB=quadra
POSTGRES_USER=quadra
POSTGRES_PASSWORD=troque-esta-senha-forte

# Chave de assinatura do JWT — mínimo 32 caracteres, aleatória.
# Gere com: openssl rand -base64 48
JWT_KEY=troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres

# Porta local exposta pelo container web (o reverse proxy do host aponta o subdomínio para cá).
WEB_PORT=8090
