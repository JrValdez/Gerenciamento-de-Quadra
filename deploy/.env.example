# Copie para .env e ajuste os valores (NUNCA versione o .env real).
POSTGRES_DB=quadra
POSTGRES_USER=quadra
POSTGRES_PASSWORD=troque-esta-senha-forte

# Chave de assinatura do JWT — mínimo 32 caracteres, aleatória.
# Gere com: openssl rand -base64 48
JWT_KEY=troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres

# Administrador inicial (criado só na primeira execução, se ainda não existir).
# Coloque os valores reais apenas no .env (NUNCA versione). A senha é armazenada com hash.
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-forte

# URL pública do site — usada para montar o link de redefinição de senha no e-mail.
APP_BASE_URL=https://seu-dominio

# SMTP para envio de e-mail (redefinição de senha). Grátis com Gmail:
#   Host=smtp.gmail.com, Port=587, User=seu-email, Password=SENHA DE APP (2FA ligado).
# Se deixar em branco, o e-mail não é enviado (o link fica só no log da API).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Porta local exposta pelo container web (o reverse proxy do host aponta o subdomínio para cá).
WEB_PORT=8090
