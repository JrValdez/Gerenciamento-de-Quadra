# Exemplo de server block do nginx DO HOST (VPS) para expor o app num subdomínio,
# sem interferir nos sites já existentes (ex.: grupof2.tech / Dota).
#
# 1) Salve como /etc/nginx/sites-available/quadra e crie o symlink em sites-enabled.
# 2) Aponte o DNS do subdomínio (ex.: quadra.grupof2.tech) para o IP do VPS.
# 3) Rode certbot para o TLS:  certbot --nginx -d quadra.grupof2.tech
# 4) nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name quadra.grupof2.tech;

    location / {
        proxy_pass http://127.0.0.1:8090;   # container "web" da stack (WEB_PORT)
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
